# Copy to .env and fill in. .env is gitignored; never commit real values.
#   cp .env.example .env

# ---- database -------------------------------------------------------------
# REQUIRED. Compose refuses to start without it. Generate one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_USER=pushpak
POSTGRES_DB=pushpak

# ---- licensed fare API ----------------------------------------------------
# Free token: https://www.travelpayouts.com/developers/api
# Without it, collection falls back to labelled synthetic data and says so in
# every index value's synthetic_share.
TRAVELPAYOUTS_TOKEN=

# ---- runtime --------------------------------------------------------------
# Host port for the API. Behind Dokploy/Traefik you can ignore this.
API_PORT=8000
# 1 seeds 30 days of labelled synthetic history when the database is empty.
# Set 0 for a deployment that should only ever hold collected data.
PUSHPAK_SEED_ON_START=1
TZ=Asia/Kolkata

# ---- local development only ----------------------------------------------
# Used by make/pytest outside Docker. NOTE: the test suite DROPS the tables in
# whatever this points at — never point it at a database with data you want.
# PUSHPAK_DB_URL=postgresql://pushpak@127.0.0.1:5433/pushpak
